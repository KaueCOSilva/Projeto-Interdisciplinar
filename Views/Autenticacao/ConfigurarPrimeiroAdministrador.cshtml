@{
    ViewData["Title"] = "Configuração inicial";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/views/autenticacao/login.css?v=1" />
</head>
<body class="login-page">
    <main class="login-container">
        <div class="login-card">
            <div class="text-center">
                <div class="login-icon"><i class="bi bi-person-lock"></i></div>
                <h1 class="login-title">Primeiro administrador</h1>
                <p class="login-subtitle">Configure o acesso usando os dados já cadastrados</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
            }

            <form asp-controller="Autenticacao" asp-action="ConfigurarPrimeiroAdministrador" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-2">
                    <label for="uid" class="form-label">UID (ID de Pessoas)*</label>
                    <input id="uid" name="uid" type="number" min="1" class="form-control" required />
                </div>
                <div class="mb-2">
                    <label for="cpf" class="form-label">CPF cadastrado*</label>
                    <input id="cpf" name="cpf" type="text" class="form-control" autocomplete="off" required />
                </div>
                <div class="mb-2">
                    <label for="email" class="form-label">E-mail cadastrado*</label>
                    <input id="email" name="email" type="email" class="form-control" autocomplete="email" required />
                </div>
                <div class="mb-2">
                    <label for="chaveConfiguracao" class="form-label">Chave local de configuração*</label>
                    <input id="chaveConfiguracao" name="chaveConfiguracao" type="password" class="form-control" autocomplete="off" required />
                </div>
                <div class="mb-2">
                    <label for="senha" class="form-label">Nova senha (mínimo 8 caracteres)*</label>
                    <input id="senha" name="senha" type="password" class="form-control" minlength="8" autocomplete="new-password" required />
                </div>
                <div class="mb-3">
                    <label for="confirmarSenha" class="form-label">Confirme a senha*</label>
                    <input id="confirmarSenha" name="confirmarSenha" type="password" class="form-control" minlength="8" autocomplete="new-password" required />
                </div>
                <button type="submit" class="btn login-button">Configurar acesso</button>
            </form>
            <div class="text-center mt-3">
                <a asp-controller="Autenticacao" asp-action="Login" class="forgot-password">Voltar ao login</a>
            </div>
        </div>
    </main>
</body>
</html>
