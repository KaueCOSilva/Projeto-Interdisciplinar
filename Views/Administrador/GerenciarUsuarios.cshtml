@model SIVAD.Models.ViewModels.EmployeeManagementViewModel
@{
    ViewData["Title"] = "Gerenciamento de Funcionários";
}
<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SIVAD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-admin.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/gerenciar-usuarios.css?v=2" />
    <link rel="stylesheet" href="/css/shared/profile-avatars.css?v=1" />
</head>
<body class="user-management-page">
    <div class="user-management-shell">
        <partial name="Sidebar" />

        <main class="user-management-main-content">
            <header class="user-management-topbar">
                <div class="user-management-topbar-title">
                    <h1>Gerenciamento de Funcionários</h1>
                    <p>Bem-vindo ao sistema de gestão</p>
                </div>
                <div class="user-management-topbar-actions" aria-label="Ações do usuário">
                    <a class="user-management-notification" asp-controller="Administrador"
                        asp-action="Notificacoes" aria-label="Notificações">
                        <i class="bi bi-bell" aria-hidden="true"></i>
                        @if (ViewBag.TotalNotificacoes is int alertas && alertas > 0) { <span title="@alertas notificações pendentes" aria-label="@alertas notificações pendentes"></span> }
                    </a>
                </div>
            </header>

            <div class="user-management-content">
                <section class="user-management-intro" aria-labelledby="user-management-heading">
                    <h2 id="user-management-heading">Gerenciamento de Funcionários</h2>
                    <p>Gerencie os funcionários cadastrados e atualize seus dados de acesso</p>
                </section>

                @if (TempData["Erro"] is string erro) { <div class="alert alert-danger" role="alert">@erro</div> }
                @if (TempData["Sucesso"] is string sucesso) { <div class="alert alert-success" role="status">@sucesso</div> }
                @if (TempData["Aviso"] is string aviso) { <div class="alert alert-info" role="status">@aviso</div> }
                <div class="alert alert-info" role="status">A lista abaixo vem da tabela Funcionarios. O acesso é mantido separadamente, com senha em hash; remover desativa o funcionário e preserva pedidos antigos.</div>

                <section class="user-management-panel employee-edit-panel" aria-labelledby="employee-edit-heading">
                    <div class="user-management-panel-heading">
                        <span class="user-management-panel-icon" aria-hidden="true">
                            <i class="bi bi-person-gear"></i>
                        </span>
                        <h3 id="employee-edit-heading">Editar Funcionário</h3>
                    </div>

                    <form id="employeeEditForm" class="employee-edit-form" asp-controller="Administrador" asp-action="EditarFuncionario" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input id="editEmployeeId" type="hidden" name="id" value="@Model.FuncionarioEmEdicaoId" />
                        @if (Model.SolicitacaoRecuperacaoId.HasValue)
                        {
                            <input type="hidden" name="solicitacaoId" value="@Model.SolicitacaoRecuperacaoId" />
                        }
                        <div class="employee-edit-fields">
                            <div class="user-management-field">
                                <label for="editEmployeeName">Nome do Funcionário</label>
                                <input id="editEmployeeName" class="form-control user-management-input" type="text" name="nome" value="@Model.FuncionarioEmEdicaoNome" placeholder="Selecione um funcionário na lista" maxlength="150" required />
                            </div>
                            <div class="user-management-field">
                                <label for="editEmployeeIdDisplay">ID do Funcionário</label>
                                <input id="editEmployeeIdDisplay" class="form-control user-management-input" type="text" value="@Model.FuncionarioEmEdicaoId" placeholder="Selecione um funcionário" readonly />
                            </div>
                            <div class="user-management-field">
                                <label for="editEmployeePassword">@(Model.SolicitacaoRecuperacaoId.HasValue ? "Nova senha do funcionário" : "Nova senha (opcional)")</label>
                                <input id="editEmployeePassword" class="form-control user-management-input" type="password" name="novaSenha" placeholder="Digite a nova senha" minlength="8" autocomplete="new-password" required="@Model.SolicitacaoRecuperacaoId.HasValue" />
                            </div>
                        </div>
                        @if (Model.FuncionarioEmEdicaoId.HasValue)
                        {
                            <button id="saveEmployeeEdit" class="employee-edit-submit" type="submit">Salvar alterações</button>
                        }
                        else
                        {
                            <button id="saveEmployeeEdit" class="employee-edit-submit" type="submit" disabled>Salvar alterações</button>
                        }
                    </form>
                </section>

                <section
                    class="user-management-panel registered-users-panel"
                    aria-labelledby="registered-users-heading">
                    <div class="registered-users-heading">
                        <h3 id="registered-users-heading">Funcionários Cadastrados</h3>
                    </div>
                    <div class="registered-users-list">
                        @if (Model.Funcionarios.Count == 0)
                        {
                            <p class="text-muted">Nenhum funcionário ativo cadastrado no banco.</p>
                        }
                        @foreach (var funcionario in Model.Funcionarios)
                        {
                            <article class="registered-user-row">
                                <div class="registered-user-identity">
                                    <span class="registered-user-avatar" aria-hidden="true">@(funcionario.Nome.Trim().Length > 0 ? funcionario.Nome.Trim()[0].ToString().ToUpperInvariant() : "F")</span>
                                    <div class="registered-user-details"><strong>@funcionario.Nome</strong><small>ID @funcionario.Id <span aria-hidden="true">•</span> Funcionário ativo</small></div>
                                </div>
                                <div class="registered-user-actions">
                                    <form asp-controller="Administrador" asp-action="GerenciarUsuarios" method="get">
                                        <input type="hidden" name="editarId" value="@funcionario.Id" />
                                        <button class="registered-user-edit" type="submit" aria-label="Editar @funcionario.Nome">Editar</button>
                                    </form>
                                    <a class="registered-user-edit" asp-controller="Administrador" asp-action="ConfigurarAcessoFuncionario" asp-route-id="@funcionario.Id" aria-label="Configurar acesso de @funcionario.Nome">Acesso</a>
                                    <form asp-controller="Administrador" asp-action="ExcluirUsuario" method="post" onsubmit="return confirm('Remover este funcionário da lista? Os pedidos históricos serão preservados.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@funcionario.Id" />
                                        <button class="registered-user-remove" type="submit">Remover</button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            </div>
        </main>
    </div>
</body>
</html>
