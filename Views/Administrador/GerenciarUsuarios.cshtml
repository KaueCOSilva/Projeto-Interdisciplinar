@model SIVAD.Models.ViewModels.EmployeeManagementViewModel
@{
    ViewData["Title"] = "Gerenciamento de Usuários";
}
<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SIVAD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-admin.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/gerenciar-usuarios.css?v=1" />
    <link rel="stylesheet" href="/css/shared/profile-avatars.css?v=1" />
</head>
<body class="user-management-page">
    <div class="user-management-shell">
        <partial name="Sidebar" />

        <main class="user-management-main-content">
            <header class="user-management-topbar">
                <div class="user-management-topbar-title">
                    <h1>Gerenciamento de Usuários</h1>
                    <p>Bem-vindo ao sistema de gestão</p>
                </div>
                <div class="user-management-topbar-actions" aria-label="Ações do usuário">
                    <a class="user-management-notification" asp-controller="Administrador"
                        asp-action="Notificacoes" aria-label="Notificações">
                        <i class="bi bi-bell" aria-hidden="true"></i>
                        @if (ViewBag.AlertasEstoque is int alertas && alertas > 0) { <span title="@alertas alertas de estoque" aria-label="@alertas alertas de estoque"></span> }
                    </a>
                </div>
            </header>

            <div class="user-management-content">
                <section class="user-management-intro" aria-labelledby="user-management-heading">
                    <h2 id="user-management-heading">Gerenciamento de Usuários</h2>
                    <p>Gerencie usuários e altere senhas</p>
                </section>

                @if (TempData["Erro"] is string erro) { <div class="alert alert-danger" role="alert">@erro</div> }
                @if (TempData["Sucesso"] is string sucesso) { <div class="alert alert-success" role="status">@sucesso</div> }
                <div class="alert alert-info" role="status">A lista abaixo vem da tabela Funcionarios. Remover desativa o funcionário, preservando pedidos antigos. O schema ainda não armazena senhas de acesso.</div>

                <section class="user-management-panel user-password-panel" aria-labelledby="password-panel-heading">
                    <div class="user-management-panel-heading">
                        <span class="user-management-panel-icon" aria-hidden="true">
                            <i class="bi bi-lock"></i>
                        </span>
                        <h3 id="password-panel-heading">Alteração de Senha</h3>
                    </div>

                    <form class="user-password-form" autocomplete="off">
                        <div class="user-password-fields">
                            <div class="user-management-field">
                                <label for="new-password">Nova Senha</label>
                                <input
                                    id="new-password"
                                    class="form-control user-management-input"
                                    type="password"
                                    placeholder="Digite a nova senha"
                                    autocomplete="new-password" />
                            </div>
                            <div class="user-management-field">
                                <label for="target-username">Nome do Usuário</label>
                                <input
                                    id="target-username"
                                    class="form-control user-management-input"
                                    type="text"
                                    placeholder="Digite o nome do usuário"
                                    autocomplete="off" />
                            </div>
                            <div class="user-management-field">
                                <label for="confirm-new-password">Confirmar Nova Senha</label>
                                <input
                                    id="confirm-new-password"
                                    class="form-control user-management-input"
                                    type="password"
                                    placeholder="Digite novamente a senha"
                                    autocomplete="new-password" />
                            </div>
                            <div class="user-management-field">
                                <label for="user-uid">UID</label>
                                <input
                                    id="user-uid"
                                    class="form-control user-management-input"
                                    type="text"
                                    placeholder="Identificador único"
                                    autocomplete="off" />
                            </div>
                        </div>
                        <button class="user-password-submit" type="button" disabled title="Requer tabela de credenciais no banco">Confirmar</button>
                    </form>
                </section>

                <section
                    class="user-management-panel registered-users-panel"
                    aria-labelledby="registered-users-heading">
                    <div class="registered-users-heading">
                        <h3 id="registered-users-heading">Usuários Cadastrados</h3>
                    </div>
                    <div class="registered-users-list">
                        @if (Model.Funcionarios.Count == 0)
                        {
                            <p class="text-muted">Nenhum funcionário ativo cadastrado no banco.</p>
                        }
                        @foreach (var funcionario in Model.Funcionarios)
                        {
                            <article class="registered-user-row">
                                <div class="registered-user-identity">
                                    <span class="registered-user-avatar" aria-hidden="true">@(funcionario.Nome.Trim().Length > 0 ? funcionario.Nome.Trim()[0].ToString().ToUpperInvariant() : "F")</span>
                                    <div class="registered-user-details"><strong>@funcionario.Nome</strong><small>ID @funcionario.Id <span aria-hidden="true">•</span> Funcionário ativo</small></div>
                                </div>
                                <div class="registered-user-actions">
                                    <button class="registered-user-edit" type="button" data-edit-employee data-name="@funcionario.Nome" data-form="edit-employee-@funcionario.Id">Editar</button>
                                    <form id="edit-employee-@funcionario.Id" asp-controller="Administrador" asp-action="EditarFuncionario" method="post" hidden>
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@funcionario.Id" />
                                        <input type="hidden" name="nome" />
                                    </form>
                                    <form asp-controller="Administrador" asp-action="ExcluirUsuario" method="post" onsubmit="return confirm('Remover este funcionário da lista? Os pedidos históricos serão preservados.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@funcionario.Id" />
                                        <button class="registered-user-remove" type="submit">Remover</button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            </div>
        </main>
    </div>
    <script>
        document.querySelectorAll('[data-edit-employee]').forEach(button => button.addEventListener('click', () => {
            const nome = window.prompt('Nome do funcionário:', button.dataset.name);
            if (nome === null || !nome.trim()) return;
            const form = document.getElementById(button.dataset.form);
            form.querySelector('[name="nome"]').value = nome.trim();
            form.requestSubmit();
        }));
    </script>
</body>
</html>
