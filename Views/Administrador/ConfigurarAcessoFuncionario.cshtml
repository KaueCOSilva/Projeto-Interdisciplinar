@{
    ViewData["Title"] = "Configurar acesso do funcionário";
}
<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SIVAD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-admin.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/cadastrar-usuario.css?v=1" />
</head>
<body class="employee-registration-page">
    <div class="employee-page-shell">
        <partial name="Sidebar" />
        <main class="employee-main-content">
            <header class="employee-topbar">
                <div class="employee-page-heading">
                    <h1>Configurar acesso do funcionário</h1>
                    <p>@ViewBag.FuncionarioNome — UID @ViewBag.FuncionarioId</p>
                </div>
            </header>
            <section class="employee-content" aria-labelledby="access-form-title">
                <div class="employee-form-card">
                    <div class="employee-form-heading">
                        <div class="employee-form-icon" aria-hidden="true"><i class="bi bi-person-lock"></i></div>
                        <div><h2 id="access-form-title">Credenciais de acesso</h2><p>A senha é armazenada como hash, nunca em texto simples.</p></div>
                    </div>
                    @if (TempData["Erro"] is string erro) { <div class="alert alert-danger" role="alert">@erro</div> }
                    <form class="employee-registration-form" method="post" asp-controller="Administrador" asp-action="ConfigurarAcessoFuncionario">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@ViewBag.FuncionarioId" />
                        <div class="employee-fields-grid">
                            <div class="employee-field">
                                <label for="email">E-mail cadastrado<span aria-hidden="true">*</span></label>
                                <input id="email" name="email" type="email" class="form-control employee-input" autocomplete="email" required />
                            </div>
                            <div class="employee-field">
                                <label for="senha">Senha inicial / nova senha<span aria-hidden="true">*</span></label>
                                <input id="senha" name="senha" type="password" class="form-control employee-input" minlength="8" autocomplete="new-password" required />
                            </div>
                            <div class="employee-field">
                                <label for="confirmarSenha">Confirmar senha<span aria-hidden="true">*</span></label>
                                <input id="confirmarSenha" name="confirmarSenha" type="password" class="form-control employee-input" minlength="8" autocomplete="new-password" required />
                            </div>
                        </div>
                        <button class="employee-submit-button" type="submit">Salvar acesso</button>
                    </form>
                </div>
            </section>
        </main>
    </div>
</body>
</html>
