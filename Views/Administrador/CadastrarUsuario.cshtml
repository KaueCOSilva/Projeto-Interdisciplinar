@{
    ViewData["Title"] = "Cadastro de Funcionário";
}
<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SIVAD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-admin.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/cadastrar-usuario.css?v=1" />
    <link rel="stylesheet" href="/css/shared/profile-avatars.css?v=1" />
</head>
<body class="employee-registration-page">
    <div class="employee-page-shell">
        <partial name="Sidebar" />

        <main class="employee-main-content">
            <header class="employee-topbar">
                <div class="employee-page-heading">
                    <h1>Cadastro de Funcionário</h1>
                    <p>Bem-vindo ao sistema de gestão</p>
                </div>

                <div class="employee-topbar-actions" aria-label="Ações do usuário">
                    <button class="employee-notification-button" type="button" aria-label="Notificações">
                        <a asp-controller="Administrador"
                           asp-action="Notificacoes">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            <span class="employee-notification-dot" aria-hidden="true"></span>
                        </a>
                    </button>
                </div>
            </header>

            <section class="employee-content" aria-labelledby="employee-form-title">
                <div class="employee-form-card">
                    <div class="employee-form-heading">
                        <div class="employee-form-icon" aria-hidden="true">
                            <i class="bi bi-person-plus"></i>
                        </div>
                        <div>
                            <h2 id="employee-form-title">Dados do Funcionário</h2>
                            <p>Informe todos os campos obrigatórios</p>
                        </div>
                    </div>

                    <form class="employee-registration-form"
                          method="post"
                          asp-controller="Administrador"
                          asp-action="CadastrarUsuario">
                        @Html.AntiForgeryToken()

                        <div class="employee-fields-grid">
                            <div class="employee-field">
                                <label for="NomeUsuario">Nome do Usuário<span aria-hidden="true">*</span></label>
                                <input id="NomeUsuario"
                                       name="NomeUsuario"
                                       type="text"
                                       class="form-control employee-input"
                                       placeholder="Digite o nome de usuário"
                                       autocomplete="username"
                                       required />
                            </div>

                            <div class="employee-field">
                                <label for="Senha">Senha<span aria-hidden="true">*</span></label>
                                <input id="Senha"
                                       name="Senha"
                                       type="password"
                                       class="form-control employee-input"
                                       placeholder="Senha de acesso ao sistema"
                                       autocomplete="new-password"
                                       required />
                            </div>
                        </div>

                        <button class="employee-submit-button" type="submit">Confirmar Cadastro</button>
                    </form>
                </div>
            </section>
        </main>
    </div>
</body>
</html>
