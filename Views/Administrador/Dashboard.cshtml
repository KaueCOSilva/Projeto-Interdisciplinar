@model SIVAD.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Dashboard - Sistema ERP</title>

    <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-admin.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/dashboard.css?v=2" />
    <link rel="stylesheet" href="/css/views/administrador/relatorios.css?v=1" />
    <link rel="stylesheet" href="/css/shared/profile-avatars.css?v=1" />

</head>

<body class="dashboard-page">
    <div class="erp-layout">
        <partial name="Sidebar" />

        <main class="main-content">

        <!-- =====================================================
            TOPBAR
        ====================================================== -->

        <header class="topbar">

            <div class="page-title">

                <h1>
                    Dashboard
                </h1>

                <p>
                    Bem-vindo ao sistema de gestão
                </p>

            </div>

            <div class="topbar-right">

                <div class="notification-button">
                    <a asp-controller="Administrador"
                            asp-action="Notificacoes">
                    <i class="bi bi-bell"></i>

                    @if (Model.AlertasEstoque > 0)
                    {
                        <span class="notification-badge" aria-label="@Model.AlertasEstoque alertas de estoque">@Model.AlertasEstoque</span>
                    }
                    </a>
                </div>

            </div>

        </header>

        <!-- =====================================================
            DASHBOARD
        ====================================================== -->

        <section class="dashboard">

            <!-- =================================================
                CARDS
            ================================================== -->

            <div class="stats">

                <!-- TOTAL VENDAS -->

                <div class="stat-card">

                    <div>

                        <span class="stat-title">
                            Total de Vendas
                        </span>

                        <span class="stat-value">
                            @Model.VendasTotais.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                        </span>

                        <span class="stat-change positive">
                            Vendas finalizadas no banco
                        </span>

                    </div>

                    <div class="stat-icon blue">

                        <i class="bi bi-currency-dollar"></i>

                    </div>

                </div>

                <!-- RECEITA -->

                <div class="stat-card">

                    <div>

                        <span class="stat-title">
                            Receita Mensal
                        </span>

                        <span class="stat-value">
                            @Model.VendasDoMes.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))
                        </span>

                        <span class="stat-change positive">
                            Vendas finalizadas neste mês
                        </span>

                    </div>

                    <div class="stat-icon green">

                        <i class="bi bi-graph-up-arrow"></i>

                    </div>

                </div>

                <!-- PRODUTOS -->

                <div class="stat-card">

                    <div>

                        <span class="stat-title">
                            Produtos Vendidos
                        </span>

                        <span class="stat-value">
                            @Model.UnidadesVendidas
                        </span>

                        <span class="stat-change positive">
                            Unidades em pedidos finalizados
                        </span>

                    </div>

                    <div class="stat-icon purple">

                        <i class="bi bi-box"></i>

                    </div>

                </div>

                <!-- DEVOLUÇÕES -->

                <div class="stat-card">

                    <div>

                        <span class="stat-title">
                            Pedidos Cancelados
                        </span>

                        <span class="stat-value">
                            @Model.PedidosCancelados
                        </span>

                        <span class="stat-change negative">
                            Pedidos com status cancelado
                        </span>

                    </div>

                    <div class="stat-icon orange">

                        <i class="bi bi-cart-x"></i>

                    </div>

                </div>

            </div>

            <!-- =================================================
                VENDAS + ATIVIDADES
            ================================================== -->

            <div class="top-panels">

                <!-- VENDAS E RECEITA -->

                <div class="panel">

                    <div class="panel-title">

                        <h2>
                            Vendas e Compras
                        </h2>

                    </div>

                    <div id="salesChart"></div>

                </div>

                <!-- ATIVIDADES -->

                <div class="panel">

                    <div class="panel-title">

                        <h2>
                            Atividades Recentes
                        </h2>

                    </div>

                    <div class="activities">
                        @if (Model.Atividades.Count == 0)
                        {
                            <div class="activity"><span class="activity-title">Nenhum pedido ou compra encontrado no banco.</span></div>
                        }
                        @foreach (var item in Model.Atividades)
                        {
                            var color = item.Tipo == "cancelado" ? "#ef4444" : item.Tipo == "pendente" ? "#f1b90b" : item.Tipo == "compra" ? "#2160dc" : "#20bf6b";
                            <div class="activity">
                                <span class="activity-dot" style="background:@color;"></span>
                                <div class="activity-info">
                                    <span class="activity-title">@item.Descricao</span>
                                    <span class="activity-time">@item.Data.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>
                        }
                    </div>

                </div>

            </div>

            <!-- =================================================
                CATEGORIAS + NOTIFICAÇÕES
            ================================================== -->

            <div class="bottom-panels">

                <!-- VENDAS POR CATEGORIA -->

                <div class="panel">

                    <div class="panel-title">

                        <h2>
                            Vendas por Categoria
                        </h2>

                    </div>

                    <div id="categoryChart"></div>

                </div>

                <!-- NOTIFICAÇÕES IMPORTANTES -->

                <div class="panel">

                    <div class="panel-title">

                        <h2>
                            Notificações Importantes
                        </h2>

                    </div>

                    <div class="notifications">
                        @if (Model.EstoqueBaixo.Count == 0)
                        {
                            <div class="important-notification info"><i class="bi bi-check-circle"></i><div class="important-text"><span class="important-title">Estoque</span><span class="important-description">Nenhum produto com estoque baixo.</span></div></div>
                        }
                        @foreach (var produto in Model.EstoqueBaixo)
                        {
                            <div class="important-notification warning">
                                <i class="bi bi-exclamation-circle"></i>
                                <div class="important-text"><span class="important-title">@produto.Nome</span><span class="important-description">@produto.Estoque unidades — @produto.Categoria.Nome</span></div>
                            </div>
                        }
                    </div>

                </div>

            </div>

            <div class="history-panels">
                <div class="panel">
                    <div class="panel-title">
                        <h2>Compras de Estoque por Ano</h2>
                    </div>
                    <div id="stockPurchaseHistoryChart" aria-label="Compras de estoque recebidas por ano"></div>
                </div>
            </div>

        </section>

    </main>

</div>

<!-- =============================================================
    GOOGLE CHARTS
============================================================== -->

<!-- CORREÇÃO: biblioteca do Google Charts (sem esta linha, "google" não existe e os gráficos não aparecem) -->
<script src="https://www.gstatic.com/charts/loader.js"></script>

<script>

    google.charts.load("current", {
        packages: ["corechart"]
    });

    google.charts.setOnLoadCallback(function () {

        desenharGraficoVendas();

        desenharGraficoCategorias();

        desenharGraficoComprasHistoricas();

    });

    /* ============================================================
        VENDAS E RECEITA
    ============================================================= */

    function desenharGraficoVendas() {

        const dados =
            google.visualization.arrayToDataTable([

                ["Mês", "Vendas", "Compras de estoque"],

                ...@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VendasPorMes.Select(item => new object[] { item.Label, item.Total, item.Compras })))

            ]);

        const opcoes = {

            backgroundColor: "transparent",

            legend: {
                position: "bottom",
                textStyle: { color: "#6b7280", fontSize: 9 }
            },

            colors: [
                "#3d7ff0",
                "#46c9a2"
            ],

            chartArea: {
                left: 52,
                top: 12,
                width: "86%",
                height: "77%"
            },

            hAxis: {

                textStyle: {
                    color: "#9ca3af",
                    fontSize: 8
                },

                gridlines: {
                    color: "transparent"
                },

                baselineColor: "#d8dce2"

            },

            vAxis: {

                minValue: 0,

                

                format: "short",

                textStyle: {
                    color: "#9ca3af",
                    fontSize: 8
                },

                gridlines: {
                    color: "#edf0f3",
                    count: 5
                },

                baselineColor: "#d8dce2"

            },

            curveType: "function",

            lineWidth: 2,

            pointSize: 4,

            animation: {

                startup: true,

                duration: 700,

                easing: "out"

            }

        };

        const grafico =
            new google.visualization.LineChart(
                document.getElementById("salesChart")
            );

        grafico.draw(dados, opcoes);

    }

    /* ============================================================
        VENDAS POR CATEGORIA
    ============================================================= */

    function desenharGraficoCategorias() {

        const dados =
            google.visualization.arrayToDataTable([

                ["Categoria", "Quantidade"],

                ...@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VendasPorCategoria.Select(item => new object[] { item.Categoria, item.Quantidade })))

            ]);

        const opcoes = {

            backgroundColor: "transparent",

            legend: {
                position: "none"
            },

            colors: [
                "#2160dc"
            ],

            chartArea: {

                left: 43,
                top: 8,

                width: "87%",
                height: "74%"

            },

            bar: {

                groupWidth: "57%"

            },

            hAxis: {

                textStyle: {

                    color: "#8f969f",

                    fontSize: 7

                },

                slantedText: true,

                slantedTextAngle: 25

            },

            vAxis: {

                minValue: 0,

                

                ticks: [

                ],

                textStyle: {

                    color: "#9ca3af",

                    fontSize: 8

                },

                gridlines: {

                    color: "#edf0f3"

                },

                baselineColor: "#d8dce2"

            },

            animation: {

                startup: true,

                duration: 700,

                easing: "out"

            }

        };

        const grafico =
            new google.visualization.ColumnChart(
                document.getElementById("categoryChart")
            );

        grafico.draw(dados, opcoes);

    }

    function desenharGraficoComprasHistoricas() {
        const historico = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ComprasPorAno.Select(item => new object[] { item.Ano.ToString(), item.Total })));
        const recipiente = document.getElementById("stockPurchaseHistoryChart");

        if (historico.length === 0) {
            recipiente.textContent = "Nenhuma compra de estoque recebida encontrada.";
            recipiente.classList.add("chart-empty-message");
            return;
        }

        const dados = google.visualization.arrayToDataTable([
            ["Ano", "Compras de estoque"],
            ...historico
        ]);
        const opcoes = {
            backgroundColor: "transparent",
            legend: { position: "none" },
            colors: ["#46c9a2"],
            chartArea: { left: 58, top: 12, width: "87%", height: "76%" },
            hAxis: { textStyle: { color: "#9ca3af", fontSize: 9 }, gridlines: { color: "transparent" }, baselineColor: "#d8dce2" },
            vAxis: { minValue: 0, format: "short", textStyle: { color: "#9ca3af", fontSize: 8 }, gridlines: { color: "#edf0f3", count: 5 }, baselineColor: "#d8dce2" }
        };
        const grafico = new google.visualization.ColumnChart(recipiente);
        grafico.draw(dados, opcoes);
    }

    /* ============================================================
        REDIMENSIONAMENTO
    ============================================================= */

    window.addEventListener("resize", function () {

        if (typeof google !== "undefined" &&
            google.visualization) {

            desenharGraficoVendas();

            desenharGraficoCategorias();

            desenharGraficoComprasHistoricas();

        }

    });

</script>

</body>

</html>
