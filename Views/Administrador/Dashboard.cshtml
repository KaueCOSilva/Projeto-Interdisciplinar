@{
    ViewData["Title"] = "Dashboard";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Dashboard - Sistema ERP</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-admin.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/dashboard.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/relatorios.css?v=1" />

</head>



<body class="dashboard-page">
    <div class="erp-layout">
        <partial name="Sidebar" />

        <main class="main-content">



        <!-- =====================================================
             TOPBAR
        ====================================================== -->

        <header class="topbar">


            <div class="page-title">

                <h1>
                    Dashboard
                </h1>

                <p>
                    Bem-vindo ao sistema de gestão
                </p>

            </div>


            <div class="topbar-right">

                <div class="notification-button">
                    <a asp-controller="Administrador"
                         asp-action="Notificacoes">
                    <i class="bi bi-bell"></i>

                    <span class="notification-badge"></span>
                    </a>
                </div>

                <div class="topbar-avatar">
                    JD
                </div>

            </div>


        </header>


        <!-- =====================================================
             DASHBOARD
        ====================================================== -->

        <section class="dashboard">


            <!-- =================================================
                 CARDS
            ================================================== -->

            <div class="stats">


                <!-- TOTAL VENDAS -->

                <div class="stat-card">

                    <div>

                        <span class="stat-title">
                            Total de Vendas
                        </span>

                        <span class="stat-value">
                            R$ 245.890
                        </span>

                        <span class="stat-change positive">
                            ↑ 12.5% do que o ano anterior
                        </span>

                    </div>

                    <div class="stat-icon blue">

                        <i class="bi bi-currency-dollar"></i>

                    </div>

                </div>


                <!-- RECEITA -->

                <div class="stat-card">

                    <div>

                        <span class="stat-title">
                            Receita Mensal
                        </span>

                        <span class="stat-value">
                            R$ 89.230
                        </span>

                        <span class="stat-change positive">
                            ↑ 8.2% do que o mês anterior
                        </span>

                    </div>

                    <div class="stat-icon green">

                        <i class="bi bi-graph-up-arrow"></i>

                    </div>

                </div>


                <!-- PRODUTOS -->

                <div class="stat-card">

                    <div>

                        <span class="stat-title">
                            Produtos Vendidos
                        </span>

                        <span class="stat-value">
                            1.248
                        </span>

                        <span class="stat-change positive">
                            ↑ 18.7% do que o mês anterior
                        </span>

                    </div>

                    <div class="stat-icon purple">

                        <i class="bi bi-box"></i>

                    </div>

                </div>


                <!-- DEVOLUÇÕES -->

                <div class="stat-card">

                    <div>

                        <span class="stat-title">
                            Devoluções
                        </span>

                        <span class="stat-value">
                            8
                        </span>

                        <span class="stat-change negative">
                            ↓ 25.0% do que o mês anterior
                        </span>

                    </div>

                    <div class="stat-icon orange">

                        <i class="bi bi-cart-x"></i>

                    </div>

                </div>


            </div>


            <!-- =================================================
                 VENDAS + ATIVIDADES
            ================================================== -->

            <div class="top-panels">


                <!-- VENDAS E RECEITA -->

                <div class="panel">

                    <div class="panel-title">

                        <h2>
                            Vendas e Receita
                        </h2>

                    </div>

                    <div id="salesChart"></div>

                </div>


                <!-- ATIVIDADES -->

                <div class="panel">

                    <div class="panel-title">

                        <h2>
                            Atividades Recentes
                        </h2>

                    </div>


                    <div class="activities">


                        <div class="activity">

                            <span class="activity-dot"
                                  style="background:#20bf6b;">
                            </span>

                            <div class="activity-info">

                                <span class="activity-title">
                                    Nova compra registrada #4521
                                </span>

                                <span class="activity-time">
                                    Há 5 minutos
                                </span>

                            </div>

                        </div>


                        <div class="activity">

                            <span class="activity-dot"
                                  style="background:#f1b90b;">
                            </span>

                            <div class="activity-info">

                                <span class="activity-title">
                                    Estoque baixo: Produto XYZ
                                </span>

                                <span class="activity-time">
                                    Há 15 minutos
                                </span>

                            </div>

                        </div>


                        <div class="activity">

                            <span class="activity-dot"
                                  style="background:#3985f5;">
                            </span>

                            <div class="activity-info">

                                <span class="activity-title">
                                    Usuário cadastrado: Maria Silva
                                </span>

                                <span class="activity-time">
                                    Há 1 hora
                                </span>

                            </div>

                        </div>


                        <div class="activity">

                            <span class="activity-dot"
                                  style="background:#20bf6b;">
                            </span>

                            <div class="activity-info">

                                <span class="activity-title">
                                    Relatório mensal gerado
                                </span>

                                <span class="activity-time">
                                    Há 2 horas
                                </span>

                            </div>

                        </div>


                        <div class="activity">

                            <span class="activity-dot"
                                  style="background:#ef4444;">
                            </span>

                            <div class="activity-info">

                                <span class="activity-title">
                                    Pedido #3421 cancelado
                                </span>

                                <span class="activity-time">
                                    Há 3 horas
                                </span>

                            </div>

                        </div>


                    </div>

                </div>


            </div>


            <!-- =================================================
                 CATEGORIAS + NOTIFICAÇÕES
            ================================================== -->

            <div class="bottom-panels">


                <!-- VENDAS POR CATEGORIA -->

                <div class="panel">

                    <div class="panel-title">

                        <h2>
                            Vendas por Categoria
                        </h2>

                    </div>

                    <div id="categoryChart"></div>

                </div>


                <!-- NOTIFICAÇÕES IMPORTANTES -->

                <div class="panel">

                    <div class="panel-title">

                        <h2>
                            Notificações Importantes
                        </h2>

                    </div>


                    <div class="notifications">


                        <div class="important-notification warning">

                            <i class="bi bi-exclamation-circle"></i>

                            <div class="important-text">

                                <span class="important-title">
                                    Estoque Baixo
                                </span>

                                <span class="important-description">
                                    5 produtos abaixo do nível mínimo
                                </span>

                            </div>

                        </div>


                        <div class="important-notification info">

                            <i class="bi bi-info-circle"></i>

                            <div class="important-text">

                                <span class="important-title">
                                    Relatório Disponível
                                </span>

                                <span class="important-description">
                                    Relatório mensal de maio já pode ser acessado
                                </span>

                            </div>

                        </div>


                    </div>

                </div>


            </div>


        </section>


    </main>


</div>



<!-- =============================================================
     GOOGLE CHARTS
============================================================== -->

<!-- CORREÇÃO: biblioteca do Google Charts (sem esta linha, "google" não existe e os gráficos não aparecem) -->
<script src="https://www.gstatic.com/charts/loader.js"></script>

<script>

    google.charts.load("current", {
        packages: ["corechart"]
    });

    google.charts.setOnLoadCallback(function () {

        desenharGraficoVendas();

        desenharGraficoCategorias();

    });



    /* ============================================================
       VENDAS E RECEITA
    ============================================================= */

    function desenharGraficoVendas() {

        const dados =
            google.visualization.arrayToDataTable([

                ["Mês", "Vendas", "Receita"],

                ["Jan", 45000, 39000],
                ["Fev", 52000, 44000],
                ["Mar", 48000, 42000],
                ["Abr", 61000, 53000],
                ["Mai", 55000, 48000],
                ["Jun", 67000, 59000]

            ]);


        const opcoes = {

            backgroundColor: "transparent",

            legend: {
                position: "none"
            },

            colors: [
                "#3d7ff0",
                "#46c9a2"
            ],

            chartArea: {
                left: 52,
                top: 12,
                width: "86%",
                height: "77%"
            },

            hAxis: {

                textStyle: {
                    color: "#9ca3af",
                    fontSize: 8
                },

                gridlines: {
                    color: "transparent"
                },

                baselineColor: "#d8dce2"

            },

            vAxis: {

                minValue: 0,

                maxValue: 80000,

                format: "short",

                textStyle: {
                    color: "#9ca3af",
                    fontSize: 8
                },

                gridlines: {
                    color: "#edf0f3",
                    count: 5
                },

                baselineColor: "#d8dce2"

            },

            curveType: "function",

            lineWidth: 2,

            pointSize: 4,

            animation: {

                startup: true,

                duration: 700,

                easing: "out"

            }

        };


        const grafico =
            new google.visualization.LineChart(
                document.getElementById("salesChart")
            );


        grafico.draw(dados, opcoes);

    }



    /* ============================================================
       VENDAS POR CATEGORIA
    ============================================================= */

    function desenharGraficoCategorias() {

        const dados =
            google.visualization.arrayToDataTable([

                ["Categoria", "Quantidade"],

                ["Equipamentos esportivos", 45],
                ["Vestuário", 32],
                ["Acessórios", 28],
                ["Chapéu", 20],
                ["Óculos", 15]

            ]);


        const opcoes = {

            backgroundColor: "transparent",

            legend: {
                position: "none"
            },

            colors: [
                "#2160dc"
            ],

            chartArea: {

                left: 43,
                top: 8,

                width: "87%",
                height: "74%"

            },

            bar: {

                groupWidth: "57%"

            },

            hAxis: {

                textStyle: {

                    color: "#8f969f",

                    fontSize: 7

                },

                slantedText: true,

                slantedTextAngle: 25

            },

            vAxis: {

                minValue: 0,

                maxValue: 60,

                ticks: [
                    0,
                    15,
                    30,
                    45,
                    60
                ],

                textStyle: {

                    color: "#9ca3af",

                    fontSize: 8

                },

                gridlines: {

                    color: "#edf0f3"

                },

                baselineColor: "#d8dce2"

            },

            animation: {

                startup: true,

                duration: 700,

                easing: "out"

            }

        };


        const grafico =
            new google.visualization.ColumnChart(
                document.getElementById("categoryChart")
            );


        grafico.draw(dados, opcoes);

    }



    /* ============================================================
       REDIMENSIONAMENTO
    ============================================================= */

    window.addEventListener("resize", function () {

        if (typeof google !== "undefined" &&
            google.visualization) {

            desenharGraficoVendas();

            desenharGraficoCategorias();

        }

    });

</script>


</body>

</html>
