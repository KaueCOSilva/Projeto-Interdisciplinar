@{
    ViewData["Title"] = "Estoque";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sistema ERP</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/erp.css?v=2" />
</head>
<body class="stock-page">
    <div class="erp-layout">
        <partial name="Sidebar" />

        <main class="stock-main-content">
            <header class="stock-topbar">
                <div class="stock-page-title">
                    <h1>Estoque</h1>
                    <p>Bem-vindo ao sistema de gestão</p>
                </div>

                <div class="stock-topbar-actions">
                    <button type="button" class="stock-notification" aria-label="Notificações">
                        <a asp-controller="Administrador"
                         asp-action="Notificacoes">
                            <i class="bi bi-bell"></i>
                            <span class="stock-notification-dot"></span>
                        </a>
                    </button>
                    <div class="stock-top-avatar">JD</div>
                </div>
            </header>

            <section class="stock-content">
                <div class="stock-heading-row">
                    <div>
                        <h2>Estoque</h2>
                        <p>Gerencie todos os produtos em estoque</p>
                    </div>

                    <a asp-controller="Administrador"
                       asp-action="Estoque"
                       class="stock-add-button">
                        <i class="bi bi-plus-lg"></i>
                        <span>Adicionar Produto</span>
                    </a>
                </div>

                <div class="stock-table-card">
                    <div class="stock-toolbar">
                        <div class="stock-search-wrapper">
                            <i class="bi bi-search"></i>
                            <input type="search"
                                   class="stock-search"
                                   placeholder="Buscar produto, fornecedor ou ID..."
                                   aria-label="Buscar produto, fornecedor ou ID" />
                        </div>

                        <button type="button" class="stock-filter-button">
                            <i class="bi bi-funnel"></i>
                            <span>Filtros</span>
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="stock-table">
                            <thead>
                                <tr>
                                    <th scope="col">Tipo</th>
                                    <th scope="col">Produto</th>
                                    <th scope="col">Fornecedor</th>
                                    <th scope="col">Cor</th>
                                    <th scope="col">ID</th>
                                    <th scope="col">Quantidade</th>
                                    <th scope="col" class="stock-actions-heading">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Vestuário</td>
                                    <td class="stock-product-name">Camisa Polo</td>
                                    <td>Blunt</td>
                                    <td>Preto</td>
                                    <td class="stock-id">PR001</td>
                                    <td><span class="stock-quantity quantity-good">45 unidades</span></td>
                                    <td class="stock-actions">
                                        <a href="#" aria-label="Visualizar PR001"><i class="bi bi-eye"></i></a>
                                        <a href="#" aria-label="Editar PR001"><i class="bi bi-pencil-square"></i></a>
                                        <a href="#" class="stock-delete" aria-label="Excluir PR001"><i class="bi bi-trash3"></i></a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Vestuário</td>
                                    <td class="stock-product-name">Camisa Polo</td>
                                    <td>Blunt</td>
                                    <td>Azul</td>
                                    <td class="stock-id">PR002</td>
                                    <td><span class="stock-quantity quantity-warning">23 unidades</span></td>
                                    <td class="stock-actions">
                                        <a href="#" aria-label="Visualizar PR002"><i class="bi bi-eye"></i></a>
                                        <a href="#" aria-label="Editar PR002"><i class="bi bi-pencil-square"></i></a>
                                        <a href="#" class="stock-delete" aria-label="Excluir PR002"><i class="bi bi-trash3"></i></a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Vestuário</td>
                                    <td class="stock-product-name">Camisa Polo</td>
                                    <td>Blunt</td>
                                    <td>Cinza</td>
                                    <td class="stock-id">PR003</td>
                                    <td><span class="stock-quantity quantity-low">8 unidades</span></td>
                                    <td class="stock-actions">
                                        <a href="#" aria-label="Visualizar PR003"><i class="bi bi-eye"></i></a>
                                        <a href="#" aria-label="Editar PR003"><i class="bi bi-pencil-square"></i></a>
                                        <a href="#" class="stock-delete" aria-label="Excluir PR003"><i class="bi bi-trash3"></i></a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Vestuário</td>
                                    <td class="stock-product-name">Camisa Polo</td>
                                    <td>Blunt</td>
                                    <td>Marrom</td>
                                    <td class="stock-id">PR004</td>
                                    <td><span class="stock-quantity quantity-good">67 unidades</span></td>
                                    <td class="stock-actions">
                                        <a href="#" aria-label="Visualizar PR004"><i class="bi bi-eye"></i></a>
                                        <a href="#" aria-label="Editar PR004"><i class="bi bi-pencil-square"></i></a>
                                        <a href="#" class="stock-delete" aria-label="Excluir PR004"><i class="bi bi-trash3"></i></a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Vestuário</td>
                                    <td class="stock-product-name">Camisa Polo</td>
                                    <td>Blunt</td>
                                    <td>Branco</td>
                                    <td class="stock-id">PR005</td>
                                    <td><span class="stock-quantity quantity-low">12 unidades</span></td>
                                    <td class="stock-actions">
                                        <a href="#" aria-label="Visualizar PR005"><i class="bi bi-eye"></i></a>
                                        <a href="#" aria-label="Editar PR005"><i class="bi bi-pencil-square"></i></a>
                                        <a href="#" class="stock-delete" aria-label="Excluir PR005"><i class="bi bi-trash3"></i></a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Vestuário</td>
                                    <td class="stock-product-name">Camisa Polo</td>
                                    <td>Blunt</td>
                                    <td>Vinho</td>
                                    <td class="stock-id">PR006</td>
                                    <td><span class="stock-quantity quantity-good">156 unidades</span></td>
                                    <td class="stock-actions">
                                        <a href="#" aria-label="Visualizar PR006"><i class="bi bi-eye"></i></a>
                                        <a href="#" aria-label="Editar PR006"><i class="bi bi-pencil-square"></i></a>
                                        <a href="#" class="stock-delete" aria-label="Excluir PR006"><i class="bi bi-trash3"></i></a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Vestuário</td>
                                    <td class="stock-product-name">Jaqueta Jeans</td>
                                    <td>Blunt</td>
                                    <td>Azul</td>
                                    <td class="stock-id">PR007</td>
                                    <td><span class="stock-quantity quantity-warning">34 unidades</span></td>
                                    <td class="stock-actions">
                                        <a href="#" aria-label="Visualizar PR007"><i class="bi bi-eye"></i></a>
                                        <a href="#" aria-label="Editar PR007"><i class="bi bi-pencil-square"></i></a>
                                        <a href="#" class="stock-delete" aria-label="Excluir PR007"><i class="bi bi-trash3"></i></a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Vestuário</td>
                                    <td class="stock-product-name">Camisa Polo</td>
                                    <td>Blunt</td>
                                    <td>Verde</td>
                                    <td class="stock-id">PR008</td>
                                    <td><span class="stock-quantity quantity-low">5 unidades</span></td>
                                    <td class="stock-actions">
                                        <a href="#" aria-label="Visualizar PR008"><i class="bi bi-eye"></i></a>
                                        <a href="#" aria-label="Editar PR008"><i class="bi bi-pencil-square"></i></a>
                                        <a href="#" class="stock-delete" aria-label="Excluir PR008"><i class="bi bi-trash3"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </main>
    </div>
</body>
</html>
