@model SIVAD.Models.ViewModels.StockViewModel
@{
    ViewData["Title"] = "Estoque";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Sistema ERP</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-admin.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/estoque.css?v=4" />
    <link rel="stylesheet" href="/css/shared/profile-avatars.css?v=1" />
</head>
<body class="stock-page">
    <div class="erp-layout">
        <partial name="Sidebar" />

        <main class="stock-main-content">
            <header class="stock-topbar">
                <div class="stock-page-title">
                    <h1>Estoque</h1>
                    <p>Bem-vindo ao sistema de gestão</p>
                </div>

                <div class="stock-topbar-actions">
                    <a class="stock-notification" asp-controller="Administrador"
                        asp-action="Notificacoes" aria-label="Notificações">
                        <i class="bi bi-bell" aria-hidden="true"></i>
                        @if (ViewBag.TotalNotificacoes is int alertas && alertas > 0) { <span class="stock-notification-dot" title="@alertas notificações pendentes" aria-label="@alertas notificações pendentes"></span> }
                    </a>
                </div>
            </header>

            <section class="stock-content">
                <div class="stock-heading-row">
                    <div>
                        <h2>Estoque</h2>
                        <p>Gerencie todos os produtos em estoque</p>
                    </div>

                    <a href="#newProductForm" id="toggleProductForm" class="stock-add-button">
                        <i class="bi bi-plus-lg"></i>
                        <span>Adicionar Produto</span>
                    </a>
                </div>

                @if (TempData["Erro"] is string erro) { <div class="alert alert-danger" role="alert">@erro</div> }
                @if (TempData["Sucesso"] is string sucesso) { <div class="alert alert-success" role="status">@sucesso</div> }
                <section class="stock-table-card" id="newProductForm" hidden>
                    <form asp-controller="Produto" asp-action="Cadastrar" method="post" class="p-3">
                        @Html.AntiForgeryToken()
                        <h3>Novo produto</h3>
                        <div class="row g-2">
                            <div class="col-md-2"><label for="produtoBarcode">Código de barras</label><input id="produtoBarcode" class="form-control" name="CodigoBarras" required maxlength="50" /></div>
                            <div class="col-md-2"><label for="produtoNome">Nome</label><input id="produtoNome" class="form-control" name="Nome" required maxlength="150" /></div>
                            <div class="col-md-2"><label for="produtoCor">Cor</label><input id="produtoCor" class="form-control" name="Cor" placeholder="Ex.: Azul" maxlength="60" /></div>
                            <div class="col-md-2"><label for="produtoPreco">Preço unitário</label><input id="produtoPreco" class="form-control" name="PrecoUnit" type="number" min="0" step="0.01" required /></div>
                            <div class="col-md-2"><label for="produtoEstoque">Estoque inicial</label><input id="produtoEstoque" class="form-control" name="Estoque" type="number" min="0" value="0" required /></div>
                            <div class="col-md-2"><label for="produtoCategoria">Categoria</label><select id="produtoCategoria" class="form-select" name="CategoriaCodigo" required><option value="">Selecione</option>@foreach (var categoria in Model.Categorias) { <option value="@categoria.Codigo">@categoria.Nome</option> }</select></div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Salvar produto</button>
                    </form>
                </section>
                <section class="stock-table-card" id="editProductPanel" hidden>
                    <form asp-controller="Produto" asp-action="Editar" method="post" class="p-3">
                        @Html.AntiForgeryToken()
                        <h3>Editar produto</h3>
                        <input type="hidden" id="editProductId" name="Codigo" />
                        <div class="row g-2">
                            <div class="col-md-2"><label for="editProductBarcode">Código de barras</label><input id="editProductBarcode" class="form-control" name="CodigoBarras" required maxlength="50" /></div>
                            <div class="col-md-2"><label for="editProductName">Nome</label><input id="editProductName" class="form-control" name="Nome" required maxlength="150" /></div>
                            <div class="col-md-2"><label for="editProductColor">Cor</label><input id="editProductColor" class="form-control" name="Cor" placeholder="Ex.: Azul" maxlength="60" /></div>
                            <div class="col-md-2"><label for="editProductPrice">Preço unitário</label><input id="editProductPrice" class="form-control" name="PrecoUnit" type="number" min="0" step="0.01" required /></div>
                            <div class="col-md-2"><label for="editProductStock">Estoque</label><input id="editProductStock" class="form-control" name="Estoque" type="number" min="0" required /></div>
                            <div class="col-md-2"><label for="editProductCategory">Categoria</label><select id="editProductCategory" class="form-select" name="CategoriaCodigo" required>@foreach (var categoria in Model.Categorias) { <option value="@categoria.Codigo">@categoria.Nome</option> }</select></div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-3">Salvar alterações</button>
                        <button type="button" class="btn btn-secondary mt-3" id="cancelEditProduct">Cancelar</button>
                    </form>
                </section>

                <div class="stock-table-card">
                    <div class="stock-toolbar">
                        <div class="stock-search-wrapper">
                            <i class="bi bi-search"></i>
                            <input type="search"
                                    class="stock-search"
                                    placeholder="Buscar produto, fornecedor ou ID..."
                                    aria-label="Buscar produto, fornecedor ou ID" />
                        </div>

                    </div>

                    <div class="table-responsive">
                        <table class="stock-table">
                            <thead>
                                <tr>
                                    <th scope="col">Tipo</th>
                                    <th scope="col">Produto</th>
                                    <th scope="col">Fornecedor</th>
                                    <th scope="col">Cor</th>
                                    <th scope="col">ID</th>
                                    <th scope="col">Quantidade</th>
                                    <th scope="col" class="stock-actions-heading">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Produtos.Count == 0)
                                {
                                    <tr><td colspan="7" class="text-center">Nenhum produto cadastrado no banco.</td></tr>
                                }
                                @foreach (var produto in Model.Produtos)
                                {
                                    var quantidadeClass = produto.Estoque <= 10 ? "quantity-low" : produto.Estoque <= 25 ? "quantity-warning" : "quantity-good";
                                    <tr data-stock="@produto.Estoque" data-search="@produto.Nome @produto.CodigoBarras @produto.Codigo @produto.Categoria.Nome @produto.Cor @produto.FornecedorNome" data-product-id="@produto.Codigo" data-barcode="@produto.CodigoBarras" data-product-name="@produto.Nome" data-product-color="@produto.Cor" data-price="@produto.PrecoUnit.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-category="@produto.CategoriaCodigo">
                                        <td>@produto.Categoria.Nome</td>
                                        <td class="stock-product-name">@produto.Nome</td>
                                        <td>@(string.IsNullOrWhiteSpace(produto.FornecedorNome) ? "—" : produto.FornecedorNome)</td>
                                        <td>@produto.Cor</td>
                                        <td class="stock-id">@produto.CodigoBarras</td>
                                        <td><span class="stock-quantity @quantidadeClass">@produto.Estoque unidades</span></td>
                                        <td class="stock-actions">
                                            <button type="button" class="stock-edit-button" data-edit-product aria-label="Editar @produto.Nome" title="Editar produto"><i class="bi bi-pencil-square"></i></button>
                                            <button type="button" class="stock-return-button" data-return-product aria-label="Registrar devolução de @produto.Nome" title="Registrar devolução"><i class="bi bi-trash3"></i></button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div id="returnProductDialog" class="stock-return-overlay" hidden>
                    <div class="stock-return-dialog" role="dialog" aria-modal="true" aria-labelledby="returnDialogTitle" tabindex="-1">
                        <form asp-controller="Produto" asp-action="RegistrarDevolucao" method="post" class="stock-return-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="returnProductCode" name="produtoCodigo" />
                            <h3 id="returnDialogTitle">Registrar devolução</h3>
                            <p class="return-product-name">Produto: <strong id="returnProductName"></strong></p>
                            <p class="return-current-stock" id="returnProductCurrentStock"></p>
                            <label for="returnQuantity">Quantidade devolvida</label>
                            <input id="returnQuantity" class="form-control" name="quantidade" type="number" min="1" step="1" required />
                            <small class="text-muted">O valor registrado no relatório usa o preço unitário atual do produto.</small>
                            <div class="return-dialog-actions">
                                <button type="button" class="btn btn-outline-secondary" data-close-return>Voltar</button>
                                <button type="submit" class="btn btn-primary">Confirmar devolução</button>
                            </div>
                        </form>
                    </div>
                </div>
            </section>
        </main>
    </div>
    <script>

        const search = document.querySelector('.stock-search');
        function filterRows() {
            const query = (search?.value || '').toLocaleLowerCase('pt-BR');
            document.querySelectorAll('.stock-table tbody tr[data-stock]').forEach(row => {
                const matchesText = row.dataset.search.toLocaleLowerCase('pt-BR').includes(query);
                row.hidden = !matchesText;
            });
        }
        search?.addEventListener('input', filterRows);
        document.getElementById('toggleProductForm')?.addEventListener('click', function (event) {
            event.preventDefault();
            const form = document.getElementById('newProductForm');
            form.hidden = !form.hidden;
            document.getElementById('editProductPanel').hidden = true;
            if (!form.hidden) form.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
        document.querySelectorAll('[data-edit-product]').forEach(button => button.addEventListener('click', () => {
            const row = button.closest('tr');
            document.getElementById('editProductId').value = row.dataset.productId;
            document.getElementById('editProductBarcode').value = row.dataset.barcode;
            document.getElementById('editProductName').value = row.dataset.productName;
            document.getElementById('editProductColor').value = row.dataset.productColor;
            document.getElementById('editProductPrice').value = row.dataset.price;
            document.getElementById('editProductStock').value = row.dataset.stock;
            document.getElementById('editProductCategory').value = row.dataset.category;
            document.getElementById('newProductForm').hidden = true;
            const panel = document.getElementById('editProductPanel');
            panel.hidden = false;
            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }));
        document.getElementById('cancelEditProduct')?.addEventListener('click', () => {
            document.getElementById('editProductPanel').hidden = true;
        });
        const returnDialog = document.getElementById('returnProductDialog');
        let returnButtonToRestore = null;
        const closeReturnDialog = () => {
            returnDialog.hidden = true;
            document.body.classList.remove('stock-dialog-open');
            returnButtonToRestore?.focus();
        };
        document.querySelectorAll('[data-return-product]').forEach(button => button.addEventListener('click', () => {
            const row = button.closest('tr');
            returnButtonToRestore = button;
            document.getElementById('returnProductCode').value = row.dataset.productId;
            document.getElementById('returnProductName').textContent = row.dataset.productName;
            document.getElementById('returnProductCurrentStock').textContent = 'Estoque atual: ' + row.dataset.stock + ' unidades. A quantidade devolvida será somada ao estoque.';
            const quantity = document.getElementById('returnQuantity');
            quantity.value = '';
            document.body.classList.add('stock-dialog-open');
            returnDialog.hidden = false;
            quantity.focus();
        }));
        document.querySelector('[data-close-return]')?.addEventListener('click', closeReturnDialog);
        returnDialog?.addEventListener('click', event => {
            if (event.target === returnDialog) closeReturnDialog();
        });
        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && !returnDialog.hidden) closeReturnDialog();
        });
    </script>
</body>
</html>
