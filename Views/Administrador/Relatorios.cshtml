@model SIVAD.Models.ViewModels.ReportViewModel
@{
    ViewData["Title"] = "Relatórios";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Relatórios - Sistema ERP</title>


    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-admin.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/dashboard.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/relatorios.css?v=1" />
    <link rel="stylesheet" href="/css/shared/profile-avatars.css?v=1" />

</head>

<body class="reports-page">

    <!-- =========================================================
        SIDEBAR
        ========================================================= -->

    <partial name="Sidebar" />

    <!-- =========================================================
        PÁGINA
        ========================================================= -->

    <div class="page">

        <!-- =====================================================
            TOPBAR
            ===================================================== -->

        <header class="topbar">

            <div class="page-title">

                <h1>
                    Relatórios
                </h1>

                <span>
                    Bem-vindo ao sistema de gestão
                </span>

            </div>

            <div class="top-actions">

                <div class="notification">
                    <a asp-controller="Administrador"
                            asp-action="Notificacoes">
                        <i class="bi bi-bell"></i>

                        @if (ViewBag.AlertasEstoque is int alertas && alertas > 0) { <span class="notification-dot" title="@alertas alertas de estoque" aria-label="@alertas alertas de estoque"></span> }
                    </a>

                </div>

            </div>

        </header>

        <!-- =====================================================
            CONTEÚDO
            ===================================================== -->

        <main class="content">

            <!-- =================================================
                ABAS
                ================================================= -->

            <div class="report-tabs">

                <button type="button"
                        class="report-tab"
                        data-report="diarias"
                        aria-pressed="false">

                    Vendas Diárias

                </button>

                <button type="button"
                        class="report-tab active"
                        data-report="mensais"
                        aria-pressed="true">

                    Vendas Mensais

                </button>

                <button type="button"
                        class="report-tab"
                        data-report="anuais"
                        aria-pressed="false">

                    Vendas Anuais

                </button>

                <button type="button"
                        class="report-tab"
                        data-report="devolucoes"
                        aria-pressed="false">

                    Devoluções

                </button>

                <button type="button"
                        class="report-tab"
                        data-report="caixa"
                        aria-pressed="false">

                    Fluxo de Caixa

                </button>

            </div>

            <!-- =================================================
                CARDS DE INDICADORES
                ================================================= -->

            <section class="stats-grid">

                <!-- TOTAL DE VENDAS -->

                <div class="stat-card">

                    <div class="stat-info">

                        <div class="stat-label" id="primaryMetricLabel">
                            Total de Vendas
                        </div>

                        <div class="stat-value" id="primaryMetricValue">
                            R$ 0,00
                        </div>

                        <div class="stat-change neutral" id="primaryMetricDescription">
                            Dados do SQL Server
                        </div>

                    </div>

                    <div class="stat-icon blue">

                        <i class="bi bi-currency-dollar"></i>

                    </div>

                </div>

                <!-- RECEITA -->

                <div class="stat-card">

                    <div class="stat-info">

                        <div class="stat-label" id="secondMetricLabel">
                            Receita
                        </div>

                        <div class="stat-value" id="secondMetricValue">
                            R$ 0,00
                        </div>

                        <div class="stat-change neutral" id="secondMetricDescription">
                            Soma no período selecionado
                        </div>

                    </div>

                    <div class="stat-icon green">

                        <i class="bi bi-graph-up-arrow"></i>

                    </div>

                </div>

                <!-- PRODUTOS VENDIDOS -->

                <div class="stat-card">

                    <div class="stat-info">

                        <div class="stat-label" id="thirdMetricLabel">
                            Produtos Vendidos
                        </div>

                        <div class="stat-value" id="thirdMetricValue">
                            0
                        </div>

                        <div class="stat-change neutral" id="thirdMetricDescription">
                            Unidades vendidas
                        </div>

                    </div>

                    <div class="stat-icon purple">

                        <i class="bi bi-box"></i>

                    </div>

                </div>

                <!-- CRESCIMENTO -->

                <div class="stat-card">

                    <div class="stat-info">

                        <div class="stat-label" id="fourthMetricLabel">
                            Crescimento Mensal
                        </div>

                        <div class="stat-value" id="fourthMetricValue">
                            —
                        </div>

                        <div class="stat-change neutral" id="fourthMetricDescription">
                            Sem data de pedido
                        </div>

                    </div>

                    <div class="stat-icon orange">

                        <i class="bi bi-arrow-repeat"></i>

                    </div>

                </div>

            </section>

            <!-- =================================================
                GRÁFICO + FILTROS
                ================================================= -->

            <section class="report-main">

                <!-- =================================================
                    GRÁFICO
                    ================================================= -->

                <div class="panel chart-panel">

                    <div class="panel-header" id="salesChartTitle" aria-live="polite">
                        Vendas por mês
                    </div>

                    <div class="chart-area">

                        <!-- LINHAS VERTICAIS -->

                        <div class="chart-grid">

                            <div class="grid-line"></div>
                            <div class="grid-line"></div>
                            <div class="grid-line"></div>
                            <div class="grid-line"></div>
                            <div class="grid-line"></div>

                        </div>

                        <!-- BARRAS -->

                        <div class="bars" id="reportBars"></div>

                        <!-- EIXO X -->

                        <div class="x-axis" id="reportXAxis"></div>

                    </div>

                </div>

                <!-- =================================================
                    FILTROS
                    ================================================= -->

                <div class="panel filter-panel">

                    <div class="panel-header">
                        Filtros
                    </div>

                    <div class="filter-content">

                        <label class="filter-label" for="monthFilter">
                            Selecione o Mês
                        </label>

                        <select class="month-select" id="monthFilter">

                            <option value="todos" selected>
                                Todos os meses
                            </option>

                            <option value="janeiro">
                                Janeiro
                            </option>

                            <option value="fevereiro">
                                Fevereiro
                            </option>

                            <option value="marco">
                                Março
                            </option>

                            <option value="abril">
                                Abril
                            </option>

                            <option value="maio">
                                Maio
                            </option>

                            <option value="junho">
                                Junho
                            </option>

                            <option value="julho">Julho</option>
                            <option value="agosto">Agosto</option>
                            <option value="setembro">Setembro</option>
                            <option value="outubro">Outubro</option>
                            <option value="novembro">Novembro</option>
                            <option value="dezembro">Dezembro</option>

                        </select>

                        <!-- PERÍODO -->

                        <div class="filter-box blue-box">

                            <div class="filter-box-title">
                                Período
                            </div>

                            <div class="filter-box-value" id="selectedPeriod">
                                Todos os meses
                            </div>

                        </div>

                        <!-- TRANSAÇÕES -->

                        <div class="filter-box green-box">

                            <div class="filter-box-title">
                                Total de Transações
                            </div>

                            <div class="filter-box-value" id="transactionCount">
                                0 registros
                            </div>

                        </div>

                        <!-- TICKET MÉDIO -->

                        <div class="filter-box purple-box">

                            <div class="filter-box-title" id="averageTicketLabel">
                                Ticket Médio
                            </div>

                            <div class="filter-box-value" id="averageTicket">
                                R$ 0,00
                            </div>

                        </div>

                    </div>

                </div>

            </section>

            <!-- =================================================
                CARDS INFERIORES
                ================================================= -->

            <section class="bottom-grid">

                <!-- MAIOR RENDIMENTO -->

                <div class="bottom-card">

                    <div class="bottom-title" id="bestGroupLabel">
                        Mês com maior rendimento Bruto
                    </div>

                    <div class="bottom-value" id="bestGroupValue">
                        —
                    </div>

                    <div class="bottom-description description-green" id="bestGroupDescription">
                        Sem lançamentos no filtro
                    </div>

                </div>

                <!-- CATEGORIA MAIS VENDIDA -->

                <div class="bottom-card">

                    <div class="bottom-title" id="reportTypeLabel">
                        Categoria Mais Vendida
                    </div>

                    <div class="bottom-value" id="reportTypeValue">
                        —
                    </div>

                    <div class="bottom-description description-blue" id="reportTypeDescription">
                        Dados do filtro selecionado
                    </div>

                </div>

                <!-- TAXA DE CONVERSÃO -->

                <div class="bottom-card">

                    <div class="bottom-title" id="recordsLabel">
                        Taxa de Conversão
                    </div>

                    <div class="bottom-value" id="recordsValue">
                        —
                    </div>

                    <div class="bottom-description description-purple" id="recordsDescription">
                        Sem dados para cálculo
                    </div>

                </div>

            </section>

        </main>

    </div>

    <script type="application/json" id="report-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Movimentos.Select(m => new { data = m.Data.ToString("yyyy-MM-dd"), tipo = m.Tipo, valor = m.Valor })))</script>
    <script src="/js/relatorios.js"></script>
</body>
</html>
