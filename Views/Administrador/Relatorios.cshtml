@{
    ViewData["Title"] = "Relatórios";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Relatórios - Sistema ERP</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/erp.css?v=1" />



</head>

<body class="reports-page">

    <!-- =========================================================
         SIDEBAR
         ========================================================= -->

    <partial name="Sidebar" />


    <!-- =========================================================
         PÁGINA
         ========================================================= -->

    <div class="page">


        <!-- =====================================================
             TOPBAR
             ===================================================== -->

        <header class="topbar">

            <div class="page-title">

                <h1>
                    Relatórios
                </h1>

                <span>
                    Bem-vindo ao sistema de gestão
                </span>

            </div>


            <div class="top-actions">

                <div class="notification">
                    <a asp-controller="Administrador"
                         asp-action="Notificacoes">
                        <i class="bi bi-bell"></i>

                        <span class="notification-dot"></span>
                    </a>

                </div>


                <div class="top-avatar">
                    JD
                </div>

            </div>

        </header>


        <!-- =====================================================
             CONTEÚDO
             ===================================================== -->

        <main class="content">


            <!-- =================================================
                 ABAS
                 ================================================= -->

            <div class="report-tabs">

                <button type="button"
                        class="report-tab">

                    Vendas Diárias

                </button>


                <button type="button"
                        class="report-tab active">

                    Vendas Mensais

                </button>


                <button type="button"
                        class="report-tab">

                    Vendas Anuais

                </button>


                <button type="button"
                        class="report-tab">

                    Devoluções

                </button>


                <button type="button"
                        class="report-tab">

                    Fluxo de Caixa

                </button>

            </div>


            <!-- =================================================
                 CARDS DE INDICADORES
                 ================================================= -->

            <section class="stats-grid">


                <!-- TOTAL DE VENDAS -->

                <div class="stat-card">

                    <div class="stat-info">

                        <div class="stat-label">
                            Total de Vendas
                        </div>

                        <div class="stat-value">
                            R$ 549,60
                        </div>

                        <div class="stat-change neutral">
                            Dados disponíveis no banco
                        </div>

                    </div>


                    <div class="stat-icon blue">

                        <i class="bi bi-currency-dollar"></i>

                    </div>

                </div>


                <!-- RECEITA -->

                <div class="stat-card">

                    <div class="stat-info">

                        <div class="stat-label">
                            Receita
                        </div>

                        <div class="stat-value">
                            R$ 549,60
                        </div>

                        <div class="stat-change neutral">
                            Total dos pedidos
                        </div>

                    </div>


                    <div class="stat-icon green">

                        <i class="bi bi-graph-up-arrow"></i>

                    </div>

                </div>


                <!-- PRODUTOS VENDIDOS -->

                <div class="stat-card">

                    <div class="stat-info">

                        <div class="stat-label">
                            Produtos Vendidos
                        </div>

                        <div class="stat-value">
                            4
                        </div>

                        <div class="stat-change neutral">
                            Unidades vendidas
                        </div>

                    </div>


                    <div class="stat-icon purple">

                        <i class="bi bi-box"></i>

                    </div>

                </div>


                <!-- CRESCIMENTO -->

                <div class="stat-card">

                    <div class="stat-info">

                        <div class="stat-label">
                            Crescimento Mensal
                        </div>

                        <div class="stat-value">
                            —
                        </div>

                        <div class="stat-change neutral">
                            Sem data de pedido
                        </div>

                    </div>


                    <div class="stat-icon orange">

                        <i class="bi bi-arrow-repeat"></i>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 GRÁFICO + FILTROS
                 ================================================= -->

            <section class="report-main">


                <!-- =================================================
                     GRÁFICO
                     ================================================= -->

                <div class="panel chart-panel">


                    <div class="panel-header">
                        Vendas por mês
                    </div>


                    <div class="chart-area">


                        <!-- LINHAS VERTICAIS -->

                        <div class="chart-grid">

                            <div class="grid-line"></div>
                            <div class="grid-line"></div>
                            <div class="grid-line"></div>
                            <div class="grid-line"></div>
                            <div class="grid-line"></div>

                        </div>


                        <!-- BARRAS -->

                        <div class="bars">


                            <div class="bar-row">

                                <span class="month-label">
                                    Janeiro
                                </span>

                                <div class="bar-container">

                                    <div class="bar"
                                         style="width: 100%;">
                                    </div>

                                </div>

                            </div>


                            <div class="bar-row">

                                <span class="month-label">
                                    Fevereiro
                                </span>

                                <div class="bar-container">

                                    <div class="bar"
                                         style="width: 56%;">
                                    </div>

                                </div>

                            </div>


                            <div class="bar-row">

                                <span class="month-label">
                                    Março
                                </span>

                                <div class="bar-container">

                                    <div class="bar"
                                         style="width: 42%;">
                                    </div>

                                </div>

                            </div>


                            <div class="bar-row">

                                <span class="month-label">
                                    Abril
                                </span>

                                <div class="bar-container">

                                    <div class="bar"
                                         style="width: 46%;">
                                    </div>

                                </div>

                            </div>


                            <div class="bar-row">

                                <span class="month-label">
                                    Maio
                                </span>

                                <div class="bar-container">

                                    <div class="bar"
                                         style="width: 40%;">
                                    </div>

                                </div>

                            </div>


                            <div class="bar-row">

                                <span class="month-label">
                                    Junho
                                </span>

                                <div class="bar-container">

                                    <div class="bar"
                                         style="width: 35%;">
                                    </div>

                                </div>

                            </div>


                            <div class="bar-row">

                                <span class="month-label">
                                    Julho
                                </span>

                                <div class="bar-container">

                                    <div class="bar"
                                         style="width: 46%;">
                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- EIXO X -->

                        <div class="x-axis">

                            <span>0</span>

                            <span>15.000</span>

                            <span>30.000</span>

                            <span>45.000</span>

                            <span>60.000</span>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     FILTROS
                     ================================================= -->

                <div class="panel filter-panel">


                    <div class="panel-header">
                        Filtros
                    </div>


                    <div class="filter-content">


                        <label class="filter-label">
                            Selecione o Mês
                        </label>


                        <select class="month-select">

                            <option selected>
                                Todos os meses
                            </option>

                            <option>
                                Janeiro
                            </option>

                            <option>
                                Fevereiro
                            </option>

                            <option>
                                Março
                            </option>

                            <option>
                                Abril
                            </option>

                            <option>
                                Maio
                            </option>

                            <option>
                                Junho
                            </option>

                            <option>
                                Julho
                            </option>

                        </select>


                        <!-- PERÍODO -->

                        <div class="filter-box blue-box">

                            <div class="filter-box-title">
                                Período
                            </div>

                            <div class="filter-box-value">
                                Dados atuais
                            </div>

                        </div>


                        <!-- TRANSAÇÕES -->

                        <div class="filter-box green-box">

                            <div class="filter-box-title">
                                Total de Transações
                            </div>

                            <div class="filter-box-value">
                                2 pedidos
                            </div>

                        </div>


                        <!-- TICKET MÉDIO -->

                        <div class="filter-box purple-box">

                            <div class="filter-box-title">
                                Ticket Médio
                            </div>

                            <div class="filter-box-value">
                                R$ 274,80
                            </div>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 CARDS INFERIORES
                 ================================================= -->

            <section class="bottom-grid">


                <!-- MAIOR RENDIMENTO -->

                <div class="bottom-card">

                    <div class="bottom-title">
                        Mês com maior rendimento Bruto
                    </div>

                    <div class="bottom-value">
                        Atual
                    </div>

                    <div class="bottom-description description-green">
                        R$ 549,60 em vendas
                    </div>

                </div>


                <!-- CATEGORIA MAIS VENDIDA -->

                <div class="bottom-card">

                    <div class="bottom-title">
                        Categoria Mais Vendida
                    </div>

                    <div class="bottom-value">
                        Masculino
                    </div>

                    <div class="bottom-description description-blue">
                        R$ 359,70 em vendas
                    </div>

                </div>


                <!-- TAXA DE CONVERSÃO -->

                <div class="bottom-card">

                    <div class="bottom-title">
                        Taxa de Conversão
                    </div>

                    <div class="bottom-value">
                        —
                    </div>

                    <div class="bottom-description description-purple">
                        Sem dados para cálculo
                    </div>

                </div>

            </section>

        </main>

    </div>

</body>
</html>
