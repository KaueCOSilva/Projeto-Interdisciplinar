@{
    ViewData["Title"] = "Central de Notificações";
}
<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SIVAD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-admin.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/notificacoes.css?v=1" />
    <link rel="stylesheet" href="/css/shared/profile-avatars.css?v=1" />
</head>
<body class="notifications-page">
    <div class="notifications-shell">
        <partial name="Sidebar" />

        <main class="notifications-main-content">
            <header class="notifications-topbar">
                <div class="notifications-page-heading">
                    <h1>Central de Notificações</h1>
                    <p>Bem-vindo ao sistema de gestão</p>
                </div>
                <div class="notifications-topbar-actions" aria-label="Ações do usuário">
                    <button class="notifications-bell-button" type="button" aria-label="Notificações">
                        <a asp-controller="Administrador"
                           asp-action="Notificacoes">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            <span aria-hidden="true"></span>
                        </a>
                    </button>
                </div>
            </header>

            <section class="notifications-list" aria-label="Notificações recentes">
                <article class="notification-entry notification-stock-warning">
                    <div class="notification-type-icon" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></div>
                    <div class="notification-copy">
                        <h2>Produto abaixo do estoque mínimo</h2>
                        <span class="notification-category">Estoque</span>
                        <p>O produto “Camisa Polo” está com apenas 5 unidades em estoque.</p>
                        <time>há 5 minutos</time>
                    </div>
                    <span class="notification-priority priority-high">Alta</span>
                </article>

                <article class="notification-entry notification-user-created">
                    <div class="notification-type-icon" aria-hidden="true"><i class="bi bi-people"></i></div>
                    <div class="notification-copy">
                        <h2>Novo Usuário cadastrado</h2>
                        <span class="notification-category">Cadastro</span>
                        <p>Maria Santos foi cadastrada no sistema.</p>
                        <time>há 1 hora</time>
                    </div>
                    <span class="notification-priority priority-low">Baixa</span>
                </article>

                <article class="notification-entry notification-stock-warning">
                    <div class="notification-type-icon" aria-hidden="true"><i class="bi bi-box-seam"></i></div>
                    <div class="notification-copy">
                        <h2>Produto abaixo do estoque mínimo</h2>
                        <span class="notification-category">Estoque</span>
                        <p>O produto “Camisa Polo” está com apenas 12 unidades.</p>
                        <time>há 2 horas</time>
                    </div>
                    <span class="notification-priority priority-medium">Média</span>
                </article>

                <article class="notification-entry notification-purchase-success">
                    <div class="notification-type-icon" aria-hidden="true"><i class="bi bi-cart-check"></i></div>
                    <div class="notification-copy">
                        <h2>Compra #4520 finalizada</h2>
                        <span class="notification-category">Pedido</span>
                        <p>Compra no valor de R$ 8.450,00 foi processada com sucesso.</p>
                        <time>há 3 horas</time>
                    </div>
                    <span class="notification-priority priority-low">Baixa</span>
                </article>

                <article class="notification-entry notification-system-update">
                    <div class="notification-type-icon" aria-hidden="true"><i class="bi bi-gear"></i></div>
                    <div class="notification-copy">
                        <h2>Atualização do sistema</h2>
                        <span class="notification-category">Sistema</span>
                        <p>Nova versão 2.1.0 disponível para instalação.</p>
                        <time>há 5 horas</time>
                    </div>
                    <span class="notification-priority priority-medium">Média</span>
                </article>

                <article class="notification-entry notification-sync-failure">
                    <div class="notification-type-icon" aria-hidden="true"><i class="bi bi-exclamation-circle"></i></div>
                    <div class="notification-copy">
                        <h2>Falha na sincronização</h2>
                        <span class="notification-category">Estoque</span>
                        <p>Erro ao sincronizar dados de estoque com fornecedor.</p>
                        <time>há 9 horas</time>
                    </div>
                    <span class="notification-priority priority-high">Alta</span>
                </article>
            </section>
        </main>
    </div>
</body>
</html>
