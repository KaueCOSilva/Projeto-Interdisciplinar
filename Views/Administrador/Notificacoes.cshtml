@model List<SIVAD.Models.Produto>
@{
    ViewData["Title"] = "Central de Notificações";
}
<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SIVAD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-admin.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/administrador/notificacoes.css?v=2" />
    <link rel="stylesheet" href="/css/shared/profile-avatars.css?v=1" />
</head>
<body class="notifications-page">
    <div class="notifications-shell">
        <partial name="Sidebar" />

        <main class="notifications-main-content">
            <header class="notifications-topbar">
                <div class="notifications-page-heading">
                    <h1>Central de Notificações</h1>
                    <p>Bem-vindo ao sistema de gestão</p>
                </div>
                <div class="notifications-topbar-actions" aria-label="Ações do usuário">
                    <a class="notifications-bell-button" asp-controller="Administrador"
                        asp-action="Notificacoes" aria-label="Notificações">
                        <i class="bi bi-bell" aria-hidden="true"></i>
                        @if (Model.Count > 0) { <span aria-label="@Model.Count alertas">@Model.Count</span> }
                    </a>
                </div>
            </header>

            <section class="notifications-list" aria-label="Notificações recentes">
                @if (Model.Count == 0)
                {
                    <article class="notification-entry"><div class="notification-copy"><h2>Sem alertas de estoque</h2><p>Não há produtos com estoque igual ou inferior a 10 unidades.</p></div></article>
                }
                @foreach (var produto in Model)
                {
                    var prioridade = produto.Estoque <= 5 ? "Alta" : produto.Estoque <= 10 ? "Média" : "Baixa";
                    var classe = produto.Estoque <= 5 ? "priority-high" : produto.Estoque <= 10 ? "priority-medium" : "priority-low";
                    <article class="notification-entry notification-stock-warning">
                        <div class="notification-type-icon" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></div>
                        <div class="notification-copy">
                            <h2>Produto abaixo do estoque mínimo</h2>
                            <span class="notification-category">@produto.Categoria.Nome</span>
                            <p>O produto “@produto.Nome” está com @produto.Estoque unidades em estoque.</p>
                            <time>Código @produto.CodigoBarras</time>
                        </div>
                        <span class="notification-priority @classe">@prioridade</span>
                    </article>
                }
            </section>
        </main>
    </div>
</body>
</html>
