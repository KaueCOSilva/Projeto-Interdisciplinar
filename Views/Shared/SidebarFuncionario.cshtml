@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<aside class="employee-sidebar" aria-label="Navegação do funcionário">
    <div class="employee-sidebar-brand">
        <span class="employee-sidebar-logo" aria-hidden="true"><i class="bi bi-shop"></i></span>
        <span class="employee-sidebar-brand-copy">
            <strong>Sistema ERP</strong>
            <small>Sistema Funcionário</small>
        </span>
    </div>

    <nav class="employee-sidebar-menu" aria-label="Menu principal">
        <a asp-controller="Funcionario" asp-action="RegistrarPedido"
           class="employee-sidebar-link @(currentAction == "RegistrarPedido" ? "is-active" : "")"
           aria-current="@(currentAction == "RegistrarPedido" ? "page" : null)">
            <i class="bi bi-receipt-cutoff" aria-hidden="true"></i>
            <span>Registro de Compras</span>
        </a>

        <a asp-controller="Funcionario" asp-action="ResumoCompra"
           class="employee-sidebar-link @(currentAction == "ResumoCompra" ? "is-active" : "")"
           aria-current="@(currentAction == "ResumoCompra" ? "page" : null)">
            <i class="bi bi-clipboard-data" aria-hidden="true"></i>
            <span>Resumo de Compra</span>
        </a>
    </nav>

    <div class="employee-sidebar-bottom">
        <div class="employee-sidebar-user">
            <span class="employee-sidebar-user-avatar" aria-hidden="true">JD</span>
            <span class="employee-sidebar-user-copy">
                <strong>João Silva</strong>
                <small>Funcionário</small>
            </span>
        </div>

        <a asp-controller="Autenticacao"
            asp-action="Login"
           class="logout">

            <i class="bi bi-box-arrow-right"></i>

            <span>Sair</span>

        </a>

    </div>
</aside>
