<aside class="sidebar">

    <div class="logo-area">

        <div class="logo-icon">
            <i class="bi bi-shop"></i>
        </div>

        <div class="logo-text">
            <div class="logo-title">
                Sistema ERP
            </div>

            <div class="logo-subtitle">
                Gestão Comercial
            </div>
        </div>

    </div>

    <nav class="menu">

        <!-- DASHBOARD -->

        <a asp-controller="Administrador"
           asp-action="Dashboard"
           class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">

            <i class="bi bi-grid"></i>

            <span>Dashboard</span>

        </a>

        <!-- RELATÓRIOS -->

        <a asp-controller="Administrador"
           asp-action="Relatorios"
           class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Relatorios" ? "active" : "")">

            <i class="bi bi-bar-chart-line"></i>

            <span>Relatórios</span>

        </a>

        <!-- ESTOQUE -->

        <a asp-controller="Administrador"
           asp-action="Estoque"
           class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Estoque" ? "active" : "")">

            <i class="bi bi-box-seam"></i>

            <span>Estoque</span>

        </a>

        <!-- MOVIMENTO DE COMPRAS -->

        <a asp-controller="Administrador"
           asp-action="MovimentoCompras"
           class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "MovimentoCompras" ? "active" : "")">

            <i class="bi bi-cart3"></i>

            <span>Movimento de Compras</span>

        </a>

        <!-- FUNCIONÁRIOS -->

        <div class="employees-menu">

            <a href="#"
               class="menu-item employees-menu-toggle"
               aria-expanded="true"
               aria-controls="employees-submenu">

                <i class="bi bi-people"></i>

                <span>Funcionários</span>

                <i class="bi bi-chevron-up menu-arrow"></i>

            </a>

            <div id="employees-submenu" class="submenu">

                <a asp-controller="Administrador"
                   asp-action="CadastrarUsuario"
                   class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "CadastrarUsuario" ? "active" : "")">

                    <i class="bi bi-person-plus"></i>

                    <span>Cadastro de Funcionário</span>

                </a>

                <a asp-controller="Administrador"
                   asp-action="GerenciarUsuarios"
                   class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "GerenciarUsuarios" ? "active" : "")">

                    <i class="bi bi-people"></i>

                    <span>Gerenciamento de Funcionários</span>

                </a>

            </div>

        </div>

        <!-- NOTIFICAÇÕES -->

        <a asp-controller="Administrador"
           asp-action="Notificacoes"
           class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Notificacoes" ? "active" : "")">

                <i class="bi bi-bell"></i>

                <span>Notificações</span>
        </a>

    </nav>

    <!-- USUÁRIO -->

    <div class="sidebar-bottom">

        <div class="user-area">

            <div class="user-avatar">
                JD
            </div>

            <div class="user-info">

                <span class="user-name">
                    João Silva
                </span>

                <span class="user-role">
                    Administrador
                </span>

            </div>

        </div>

        <a asp-controller="Autenticacao"
           asp-action="Login"
           class="logout">

            <i class="bi bi-box-arrow-right"></i>

            <span>Sair</span>

        </a>

    </div>

</aside>
<script src="/js/sidebar-admin.js"></script>
