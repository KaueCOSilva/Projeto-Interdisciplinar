@{
    Layout = null;
    ViewData["Title"] = "Resumo de Compra";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SIVAD</title>

    <!-- Bootstrap carregado antes dos estilos próprios do projeto. -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/funcionario/resumo-compra.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-funcionario.css?v=1" />
</head>
<body class="employee-purchase-summary-page">
    @await Html.PartialAsync("SidebarFuncionario")

    <div class="employee-summary-main">
        <header class="employee-summary-topbar">
            <div class="employee-summary-topbar-title">
                <h1>Resumo de Compra</h1>
                <p>Bem-vindo ao sistema</p>
            </div>
            <span class="employee-summary-topbar-avatar" aria-label="Usuário JD">JD</span>
        </header>

        <main class="employee-summary-content">
            <section class="employee-summary-intro" aria-labelledby="employee-summary-heading">
                <span class="employee-summary-success-icon" aria-hidden="true">
                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                </span>
                <h2 id="employee-summary-heading">Resumo de Compra</h2>
                <p>Revise os detalhes antes de confirmar</p>
            </section>

            <section class="employee-summary-card employee-summary-products" aria-label="Produtos selecionados">
                <div class="employee-summary-table-wrap">
                    <table class="employee-summary-table">
                        <thead>
                            <tr>
                                <th scope="col">Produto</th>
                                <th scope="col">Categoria</th>
                                <th scope="col">Valor</th>
                                <th scope="col">ID</th>
                                <th scope="col">Estoque</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Camisa Polo</td>
                                <td>Vestuário</td>
                                <td>R$ 3.500,00</td>
                                <td>PR001</td>
                                <td>49 un.</td>
                            </tr>
                            <tr>
                                <td>Camisa Polo</td>
                                <td>Vestuário</td>
                                <td>R$ 150,00</td>
                                <td>PR003</td>
                                <td>18 un.</td>
                            </tr>
                            <tr>
                                <td>Camisa Polo</td>
                                <td>Vestuário</td>
                                <td>R$ 450,00</td>
                                <td>PR005</td>
                                <td>17 un.</td>
                            </tr>
                            <tr>
                                <td>Camisa Polo</td>
                                <td>Vestuário</td>
                                <td>R$ 280,00</td>
                                <td>PR008</td>
                                <td>8 un.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="employee-summary-card employee-summary-count" aria-label="Quantidade de itens selecionados">
                <p>Quantidade de Itens</p>
                <strong>4</strong>
                <span>produtos selecionados</span>
            </section>

            <div class="employee-summary-actions">
                <button type="button" class="employee-summary-confirm-button" aria-disabled="true"
                        title="A contabilização ainda não está conectada ao backend">
                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                    <span>Contabilizar Compra</span>
                </button>
            </div>
        </main>
    </div>
</body>
</html>
