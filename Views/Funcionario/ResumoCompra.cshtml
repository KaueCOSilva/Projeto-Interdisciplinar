@model SIVAD.Models.Pedido
@{
    Layout = null;
    ViewData["Title"] = "Resumo de Compra";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SIVAD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/funcionario/resumo-compra.css?v=1" />
    <link rel="stylesheet" href="/css/shared/sidebar-funcionario.css?v=1" />
    <link rel="stylesheet" href="/css/shared/profile-avatars.css?v=1" />
</head>
<body class="employee-purchase-summary-page">
    @await Html.PartialAsync("SidebarFuncionario")
    <div class="employee-summary-main">
        <header class="employee-summary-topbar"><div class="employee-summary-topbar-title"><h1>Resumo de Compra</h1><p>Pedido #@Model.Codigo</p></div></header>
        <main class="employee-summary-content">
            <section class="employee-summary-intro" aria-labelledby="employee-summary-heading">
                <span class="employee-summary-success-icon" aria-hidden="true"><i class="bi bi-check-circle" aria-hidden="true"></i></span>
                <h2 id="employee-summary-heading">Resumo de Compra</h2>
                <p>Confira os dados retornados do banco antes de contabilizar</p>
            </section>
            @if (TempData["Erro"] is string erro) { <div class="alert alert-danger" role="alert">@erro</div> }
            <section class="employee-summary-card employee-summary-products" aria-label="Produtos selecionados">
                <div class="employee-summary-table-wrap">
                    <table class="employee-summary-table">
                        <thead><tr><th scope="col">Produto</th><th scope="col">Categoria</th><th scope="col">Valor</th><th scope="col">ID</th><th scope="col">Estoque</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.Itens)
                        {
                            <tr>
                                <td>@item.Produto.Nome (@item.Qtd un.)</td>
                                <td>@item.Produto.Categoria.Nome</td>
                                <td>@item.PrecoTotal.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td>
                                <td>@item.Produto.CodigoBarras</td>
                                <td>@item.Produto.Estoque un.</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
            <section class="employee-summary-card employee-summary-count" aria-label="Quantidade de itens selecionados">
                <p>Total do Pedido</p>
                <strong>@Model.ValorTotal.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong>
                <span>@Model.Itens.Sum(item => item.Qtd) unidades</span>
            </section>
            <div class="employee-summary-actions">
                <form asp-controller="Pedido" asp-action="Finalizar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Codigo" />
                    <button class="employee-summary-confirm-button" type="submit"><i class="bi bi-check-circle" aria-hidden="true"></i><span>Contabilizar Compra</span></button>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
