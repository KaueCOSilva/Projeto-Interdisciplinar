@{
    ViewData["Title"] = "Registro de Compras";
    Layout = null;
}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SIVAD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
    <link rel="stylesheet" href="/css/shared/logout-link.css?v=1" />
    <link rel="stylesheet" href="/css/views/funcionario/registrar-pedido.css?v=2" />
    <link rel="stylesheet" href="/css/shared/sidebar-funcionario.css?v=1" />
    <link rel="stylesheet" href="/css/shared/profile-avatars.css?v=1" />
</head>
<body class="employee-purchase-registration-page">
    <partial name="SidebarFuncionario" />

    <main class="employee-purchase-registration-main">
        <header class="employee-purchase-topbar">
            <div class="employee-purchase-topbar-title">
                <h1>Registro de Compras</h1>
                <p>Bem-vindo ao sistema</p>
            </div>
        </header>

        <section class="employee-purchase-content" aria-labelledby="employee-purchase-heading">
            <div class="employee-purchase-heading">
                <h2 id="employee-purchase-heading">Registro de Compra</h2>
                <p>Finalize o registro da compra</p>
            </div>

            <section
                class="employee-purchase-card employee-purchase-automatic"
                aria-labelledby="employee-purchase-auto-heading">
                <div class="employee-purchase-card-heading">
                    <h3 id="employee-purchase-auto-heading">Registrar Compra Automaticamente</h3>
                    <button
                        class="employee-purchase-read-button"
                        type="button"
                        disabled
                        aria-disabled="true"
                        title="Leitura de NF-e ainda não integrada">
                        Ler Código de NF-e
                    </button>
                </div>

                <div class="employee-purchase-table-wrap">
                    <table class="employee-purchase-table">
                        <thead>
                            <tr>
                                <th scope="col">Produto</th>
                                <th scope="col">Código</th>
                                <th scope="col">Valor</th>
                                <th scope="col">Quantidade</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Camisa Polo</td>
                                <td>PR001</td>
                                <td>R$ 3.500,00</td>
                                <td>4 un.</td>
                            </tr>
                            <tr>
                                <td>Camisa Polo</td>
                                <td>PR003</td>
                                <td>R$ 150,00</td>
                                <td>10 un.</td>
                            </tr>
                            <tr>
                                <td>Camisa Polo</td>
                                <td>PR005</td>
                                <td>R$ 450,00</td>
                                <td>5 un.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="employee-purchase-demo-note">Itens demonstrativos — leitura e importação de NF-e ainda não estão conectadas.</p>
            </section>

            <section
                class="employee-purchase-card employee-purchase-manual"
                aria-labelledby="employee-purchase-manual-heading">
                <div class="employee-purchase-card-heading employee-purchase-manual-heading">
                    <h3 id="employee-purchase-manual-heading">Registrar Compra Manualmente</h3>
                </div>
                <div class="employee-purchase-fields">
                    <div class="employee-purchase-field">
                        <label for="employee-purchase-nfe">Código de NF-e<span aria-hidden="true">*</span></label>
                        <input
                            id="employee-purchase-nfe"
                            class="employee-purchase-input"
                            type="text"
                            placeholder="000-000-000" />
                    </div>
                    <div class="employee-purchase-field">
                        <label for="employee-purchase-cpf">CPF do Cliente</label>
                        <input
                            id="employee-purchase-cpf"
                            class="employee-purchase-input"
                            type="text"
                            placeholder="000.000.000-00" />
                    </div>
                    <div class="employee-purchase-field employee-purchase-field-wide">
                        <label for="employee-purchase-name">Nome</label>
                        <input
                            id="employee-purchase-name"
                            class="employee-purchase-input"
                            type="text"
                            placeholder="Nome completo do cliente" />
                    </div>
                </div>
                <p class="employee-purchase-demo-note">Campos ilustrativos — cadastro manual ainda não está conectado ao controller.</p>
            </section>

            <form asp-controller="Funcionario" asp-action="ResumoCompra" method="get">
                <button class="employee-purchase-finish-button" type="submit">
                    Visualizar Resumo da Compra
                </button>
            </form>
        </section>
    </main>
</body>
</html>
