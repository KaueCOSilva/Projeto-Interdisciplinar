@model List<Tarefa>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <table>
        @foreach(Tarefa t in Model)
        {
        <tr>
            <td>
                @t.IdTarefa
            </td>
            <td>
                @t.Texto
            </td>
            <td>
                <input  type="checkbox" checked="@t.Concluida"/>
            </td>
        </tr>
        }
    </table>
    <a href="/tarefa/create" style="padding: 4px 2px; background-color: #ffffff68; border-radius: 2px">Adicionar</a>
</body>
</html>