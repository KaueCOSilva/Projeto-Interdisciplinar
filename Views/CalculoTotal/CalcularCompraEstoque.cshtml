@model decimal
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Total da compra de estoque - SIVAD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/base.css?v=1" />
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100">
    <main class="card shadow-sm p-4 text-center">
        <h1 class="h5 text-muted">Total da compra de estoque</h1>
        <p class="display-6 mb-3">@Model.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</p>
        <p class="small text-muted">Calculado pela TotalCompraEstoqueStrategy.</p>
        <a class="btn btn-outline-primary btn-sm" asp-controller="Autenticacao" asp-action="Login">Voltar</a>
    </main>
</body>
</html>
