@model float

@{
    ViewData["Title"] = "Total da Compra de Estoque";
}

<div class="container mt-4">
    <div class="card shadow-sm border-info">
        <div class="card-header bg-info text-white">
            <h3 class="card-title mb-0">Resultado do Cálculo (Strategy - Compra Estoque)</h3>
        </div>
        <div class="card-body text-center py-5">
            <h5 class="text-muted mb-3">Valor Total Calculado:</h5>
            <p class="display-3 fw-bold text-primary">R$ @Model.ToString("N2")</p>
        </div>
        <div class="card-footer bg-light">
            <a href="/" class="btn btn-secondary">Voltar</a>
        </div>
    </div>
</div>